# public-properties-site environment — copy to .env.local and fill in. Never commit it.
# NEXT_PUBLIC_* values are baked in at build time and are public.

# ---- URLs ----
NEXT_PUBLIC_SITE_URL_PROPERTIES=http://localhost:3006
NEXT_PUBLIC_API_URL=http://localhost:3004

# ---- PostHog (same project key as the CRM app) ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
